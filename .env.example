# ProtoNeo Environment Configuration

# Default LLM endpoint (any OpenAI SDK-compatible endpoint)
LLM_API_KEY=sk-local-1234
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=your-model-name

# Cloud providers (optional, uncomment as needed)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
