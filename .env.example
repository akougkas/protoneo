# ProtoNeo Environment Configuration

# Default LLM endpoint (any OpenAI SDK-compatible endpoint)
LLM_API_KEY=sk-local-1234
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL_NAME=your-model-name

# Cloud providers (optional, uncomment as needed)
# OPENROUTER_API_KEY=your-openrouter-api-key
# ANTHROPIC_API_KEY=...  # DISABLED: Anthropic provider removed from ProtoNeo
# ANTHROPIC_OAUTH_TOKEN=...  # DISABLED
# OPENAI_API_KEY=your-openai-api-key
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...

# Reviewer tools (optional)
# SEMANTIC_SCHOLAR_API_KEY=...
# BRAVE_API_KEY=...
# SEARXNG_URL=http://localhost:8888
# SEARXNG_TIMEOUT_SECONDS=5
# PROTONEO_REVIEW_WEB_SEARCH=auto
# PROTONEO_ENABLE_DUCKDUCKGO_SEARCH=0
